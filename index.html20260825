<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>hastaraj japanNote</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Noto+Sans+Devanagari:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#EFE7D3;
    --paper-2:#F8F3E5;
    --card:#FBF8EF;
    --ink:#292420;
    --ink-soft:#736A5E;
    --ink-faint:#A79C89;
    --line:#DED2B3;
    --seal:#AE3529;
    --seal-dark:#8A2A20;
    --seal-bg:#F5E2DD;
    --gold:#B9862E;
    --gold-bg:#F3E6C9;
    --moss:#4C7955;
    --moss-bg:#E4EDDD;
    --shadow: 0 3px 0 var(--line);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    background-image:
      radial-gradient(circle at 20% 15%, rgba(174,53,41,0.05), transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(76,121,85,0.05), transparent 45%);
    font-family:'Zen Kaku Gothic New','Inter',sans-serif;
    color:var(--ink);
    min-height:100vh;
    -webkit-font-smoothing:antialiased;
  }
  .app{ max-width:480px; margin:0 auto; min-height:100vh; padding:18px 18px 40px; display:flex; flex-direction:column; }
  .nepali{ font-family:'Noto Sans Devanagari','Zen Kaku Gothic New',sans-serif; }
  button{ font-family:inherit; cursor:pointer; }
  .btn-primary{
    background:var(--seal); color:#F9EFE9; border:none; border-radius:16px;
    padding:16px 20px; font-size:17px; font-weight:700; box-shadow:0 4px 0 var(--seal-dark);
    transition:transform .05s ease;
  }
  .btn-primary:active{ transform:translateY(3px); box-shadow:0 1px 0 var(--seal-dark); }
  .btn-primary:disabled{ opacity:.5; }
  .btn-ghost{
    background:transparent; border:1.5px solid var(--line); color:var(--ink-soft);
    border-radius:16px; padding:14px 20px; font-size:15px; font-weight:500; width:100%;
  }

  /* screens */
  .screen{ display:none; flex-direction:column; flex:1; }
  .screen.active{ display:flex; }

  .brand-mark{
    width:64px;height:64px;border-radius:50%; background:var(--seal);
    display:flex;align-items:center;justify-content:center; color:#F9EFE9;
    font-family:'Shippori Mincho',serif;font-size:26px;font-weight:700; margin:0 auto 18px;
    box-shadow:0 3px 0 var(--seal-dark);
  }
  .title-lg{ font-family:'Shippori Mincho',serif; font-size:28px; font-weight:700; text-align:center; margin:0 0 4px; }
  .sub{ text-align:center; color:var(--ink-soft); font-size:13px; margin:0 0 22px; }

  /* course select */
  .course-card{
    display:flex; align-items:center; gap:14px; background:var(--card);
    border:1px solid var(--line); border-radius:16px; padding:16px; margin-bottom:12px;
  }
  .course-icon{
    width:46px;height:46px;border-radius:23px;background:var(--seal-bg);
    display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;color:var(--seal);
    flex-shrink:0;
  }
  .course-title{ font-size:16px; font-weight:700; }
  .course-sub{ font-size:12.5px; color:var(--ink-soft); margin-top:1px; }
  .course-meta{ font-size:11.5px; color:var(--ink-faint); margin-top:4px; }
  .chevron{ font-size:22px; color:var(--ink-faint); }

  /* home */
  .top-row{ display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; }
  .course-switch{ background:none; border:none; color:var(--ink-soft); font-weight:600; font-size:13.5px; padding:6px 4px; }
  .stat-row{ display:flex; gap:10px; margin-bottom:16px; }
  .stat-card{ flex:1; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:12px 10px; text-align:center; }
  .stat-num{ font-size:20px; font-weight:700; font-family:'Shippori Mincho',serif; }
  .stat-label{ font-size:11px; color:var(--ink-soft); margin-top:2px; }
  .stat-card.mastered .stat-num{ color:var(--moss); }
  .stat-card.learning .stat-num{ color:var(--gold); }
  .stat-card.new .stat-num{ color:var(--seal); }

  .section-label{ font-size:13px; color:var(--ink-soft); font-weight:600; margin:14px 0 8px; }
  .mode-opt{
    display:flex; align-items:center; gap:10px; background:var(--card); border:1.5px solid var(--line);
    border-radius:14px; padding:12px; margin-bottom:8px;
  }
  .mode-opt.active{ border-color:var(--seal); background:var(--seal-bg); }
  .radio{ width:16px;height:16px;border-radius:8px;border:1.5px solid var(--ink-faint); flex-shrink:0; }
  .mode-opt.active .radio{ border-color:var(--seal); background:var(--seal); }
  .mode-opt-text{ font-size:13.5px; }

  .level-card{
    display:flex; align-items:center; gap:12px; background:var(--card); border:1px solid var(--line);
    border-radius:14px; padding:14px; margin-bottom:9px; text-align:left; width:100%;
  }
  .level-card:disabled{ opacity:.5; }
  .level-badge{
    width:38px;height:38px;border-radius:19px;background:var(--gold-bg);
    display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--gold); flex-shrink:0;
  }
  .level-badge.cleared{ background:var(--moss-bg); color:var(--moss); }
  .level-info{ flex:1; min-width:0; }
  .level-title{ font-size:14.5px; font-weight:700; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .level-sub{ font-size:12px; color:var(--ink-soft); margin-top:1px; }
  .lock-icon{ font-size:15px; }

  /* quiz */
  .topbar{ display:flex; align-items:center; gap:10px; }
  .close-btn{
    width:34px;height:34px;border-radius:17px;border:1px solid var(--line); background:var(--card);
    color:var(--ink-soft); font-size:16px; display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .progress-track{ flex:1; height:12px; background:var(--card); border:1px solid var(--line); border-radius:8px; overflow:hidden; }
  .progress-fill{ height:100%; width:0%; background:linear-gradient(90deg, var(--gold), var(--seal)); border-radius:8px; transition:width .35s ease; }
  .count-pill{ font-size:12.5px; font-weight:600; color:var(--ink-soft); background:var(--card); border:1px solid var(--line); border-radius:10px; padding:6px 10px; white-space:nowrap; }
  .streak-pill{ font-size:12.5px; font-weight:700; color:var(--gold); background:var(--gold-bg); border-radius:10px; padding:6px 10px; white-space:nowrap; }

  .kanji-stage{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; position:relative; min-height:200px; padding:16px 0; }
  .kanji-tag{ font-size:13px; color:var(--ink-faint); margin-bottom:10px; text-align:center; }
  .kanji-big{ font-family:'Shippori Mincho',serif; font-weight:700; font-size:clamp(48px, 15vw, 76px); line-height:1.1; text-align:center; }
  .kanji-underline{ width:56px; height:3px; background:var(--seal); border-radius:2px; margin-top:14px; opacity:.55; }

  .qa-stage{ flex:1; display:flex; flex-direction:column; justify-content:center; position:relative; padding:12px 0; }
  .qa-card{ background:var(--card); border:1px solid var(--line); border-radius:16px; padding:18px; min-height:90px; display:flex; align-items:center; }
  .qa-question{ font-size:17px; line-height:1.55; font-weight:600; }

  .stamp{
    position:absolute; top:6px; right:4px; width:68px; height:68px; border-radius:50%;
    border:3.5px solid var(--seal); color:var(--seal); display:flex; align-items:center; justify-content:center;
    font-family:'Shippori Mincho',serif; font-weight:800; font-size:22px;
    transform:rotate(-14deg) scale(0); opacity:0;
  }
  .stamp.wrong{ border-color:var(--ink-soft); color:var(--ink-soft); }
  .stamp.show{ animation:stampIn .4s cubic-bezier(.2,1.4,.4,1) forwards; }
  @keyframes stampIn{ 0%{transform:rotate(-14deg) scale(2.2);opacity:0;} 60%{transform:rotate(-14deg) scale(.92);opacity:1;} 100%{transform:rotate(-14deg) scale(1);opacity:1;} }

  .options{ display:flex; flex-direction:column; gap:11px; margin-top:8px; }
  .opt-btn{
    background:var(--card); border:1.5px solid var(--line); border-radius:14px; padding:16px 18px;
    font-size:18px; font-weight:600; text-align:center; box-shadow:var(--shadow); transition:transform .05s ease;
  }
  .opt-btn.qa{ text-align:left; font-size:14px; line-height:1.4; font-weight:500; padding:13px 16px; }
  .opt-btn:active{ transform:translateY(2px); }
  .opt-btn.correct{ background:var(--moss-bg); border-color:var(--moss); color:#2E4C36; }
  .opt-btn.wrong{ background:var(--seal-bg); border-color:var(--seal); color:var(--seal-dark); }
  .opt-btn.dim{ opacity:.45; }
  .opt-btn[disabled]{ pointer-events:none; }
  .opt-btn.small{ font-size:14px; }

  .idk-btn{
    margin-top:14px; background:var(--paper-2); border:1.5px solid var(--line); border-radius:14px;
    padding:15px 18px; font-size:15px; font-weight:600; color:var(--ink-soft); text-align:center;
  }

  .feedback{
    position:fixed; left:0; right:0; bottom:0; background:var(--card); border-top:2px solid var(--line);
    border-radius:20px 20px 0 0; padding:20px 22px 22px; box-shadow:0 -6px 18px rgba(41,36,32,.10);
    transform:translateY(105%); transition:transform .3s cubic-bezier(.25,1,.4,1); max-width:480px; margin:0 auto;
  }
  .feedback.show{ transform:translateY(0); }
  .fb-head{ display:flex; align-items:center; gap:10px; margin-bottom:4px; }
  .fb-icon{ width:28px;height:28px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px; flex-shrink:0; }
  .fb-icon.ok{ background:var(--moss); color:#F3F8EF; }
  .fb-icon.no{ background:var(--seal); color:#F9EFE9; }
  .fb-title{ font-weight:700; font-size:15px; }
  .fb-title.ok{ color:var(--moss); }
  .fb-title.no{ color:var(--seal-dark); }
  .fb-reading{ font-size:20px; font-family:'Shippori Mincho',serif; margin:10px 0 4px; font-weight:700; }
  .fb-meaning{ font-size:14px; color:var(--ink-soft); margin-bottom:16px; line-height:1.5; }

  /* result */
  .result-ring{
    width:128px; height:128px; border-radius:50%; margin:20px auto 16px; border-width:8px; border-style:solid;
    display:flex; align-items:center; justify-content:center; flex-direction:column;
  }
  .result-ring b{ font-size:28px; font-family:'Shippori Mincho',serif; }
  .result-ring span{ font-size:12px; color:var(--ink-soft); }
  .result-title{ text-align:center; font-family:'Shippori Mincho',serif; font-size:22px; font-weight:700; margin:0 0 6px; }
  .result-sub{ text-align:center; color:var(--ink-soft); font-size:14px; margin-bottom:20px; }
  .unlock-card{ background:var(--gold-bg); border-radius:16px; padding:16px; margin-bottom:18px; }
  .unlock-card.unlocked{ background:var(--moss-bg); }
  .unlock-title{ font-weight:700; font-size:15px; margin-bottom:4px; }
  .unlock-sub{ font-size:13px; color:var(--ink-soft); margin-bottom:0; }
  .miss-label{ font-size:12px; color:var(--ink-faint); font-weight:600; margin-bottom:8px; }
  .miss-item{ display:flex; align-items:center; justify-content:space-between; gap:10px; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:11px 14px; margin-bottom:8px; }
  .miss-kanji{ font-family:'Shippori Mincho',serif; font-size:19px; font-weight:700; min-width:56px; }
  .miss-reading{ font-size:12.5px; color:var(--ink-soft); }
  .miss-meaning{ font-size:12px; color:var(--ink-faint); text-align:right; flex:1; }
  .miss-qa{ background:var(--card); border:1px solid var(--line); border-radius:12px; padding:12px; margin-bottom:8px; }
  .miss-qa-q{ font-size:13px; font-weight:700; margin-bottom:4px; line-height:1.4; }
  .miss-qa-a{ font-size:12.5px; color:var(--ink-soft); line-height:1.4; }
  .footer-buttons{ margin-top:auto; padding-top:14px; }
  .footer-buttons .btn-primary{ width:100%; margin-bottom:10px; }
</style>
</head>
<body>
<div class="app">

  <!-- COURSE SELECT -->
  <div class="screen" id="screen-courseSelect">
    <div class="brand-mark">学</div>
    <h1 class="title-lg">कुन Course पढ्ने?</h1>
    <p class="sub">तह वा विषय अनुसार छान्नुहोस्</p>
    <div id="courseList"></div>
  </div>

  <!-- HOME -->
  <div class="screen" id="screen-home">
    <div class="top-row">
      <button class="course-switch" id="btnChangeCourse">‹ Course</button>
    </div>
    <div class="brand-mark" id="homeBrandMark">語</div>
    <h1 class="title-lg" id="homeTitle">N1 漢字帳</h1>
    <p class="sub" id="homeSub">JLPT N1 · 189 वाक्यांश</p>

    <div class="stat-row">
      <div class="stat-card mastered"><div class="stat-num" id="statMastered">0</div><div class="stat-label">राम्रो जानेको</div></div>
      <div class="stat-card learning"><div class="stat-num" id="statLearning">0</div><div class="stat-label">सिकिरहेको</div></div>
      <div class="stat-card new"><div class="stat-num" id="statNew">0</div><div class="stat-label">नयाँ</div></div>
    </div>

    <div id="modeSection">
      <div class="section-label">प्रश्न कसरी सोध्ने?</div>
      <div id="modeList"></div>
    </div>

    <div class="section-label">तहहरू (Levels)</div>
    <div id="levelList"></div>
  </div>

  <!-- QUIZ -->
  <div class="screen" id="screen-quiz">
    <div class="topbar">
      <button class="close-btn" id="btnQuitQuiz">✕</button>
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      <div class="count-pill" id="countPill">1/10</div>
      <div class="streak-pill">🔥 <span id="streakNum">0</span></div>
    </div>

    <div class="kanji-stage" id="vocabStage" style="display:none;">
      <div class="kanji-tag" id="kanjiTag"></div>
      <div class="kanji-big" id="kanjiBig"></div>
      <div class="kanji-underline"></div>
      <div class="stamp" id="stamp1">合</div>
    </div>

    <div class="qa-stage" id="qaStage" style="display:none;">
      <div class="kanji-tag">सही उत्तर छान्नुहोस्</div>
      <div class="qa-card"><div class="qa-question" id="qaQuestion"></div></div>
      <div class="stamp" id="stamp2">合</div>
    </div>

    <div class="options" id="optionsWrap"></div>
    <button class="idk-btn" id="btnIdk">？ थाहा छैन / I don't know</button>
  </div>

  <!-- RESULT -->
  <div class="screen" id="screen-result">
    <div style="flex:1; overflow-y:auto;">
      <div class="result-ring" id="resultRing"><b id="resultPct">0%</b><span id="resultFrac">0/10</span></div>
      <h2 class="result-title" id="resultTitle">राम्रो प्रयास!</h2>
      <p class="result-sub" id="resultSub"></p>
      <div id="unlockWrap"></div>
      <div id="missWrap"></div>
    </div>
    <div class="footer-buttons">
      <button class="btn-primary" id="btnRetry">यो तह फेरि खेल्नुहोस्</button>
      <button class="btn-ghost" id="btnResultHome">गृहपृष्ठमा फर्कनुहोस्</button>
    </div>
  </div>

</div>

<div class="feedback" id="feedback">
  <div class="fb-head">
    <div class="fb-icon" id="fbIcon">✓</div>
    <div class="fb-title" id="fbTitle">ठीक छ!</div>
  </div>
  <div class="fb-reading" id="fbReading"></div>
  <div class="fb-meaning nepali" id="fbMeaning"></div>
  <button class="btn-primary" id="btnNext" style="width:100%;">जारी राख्नुहोस्</button>
</div>

<script>
const N1_KANJI_RAW = [{"term":"案の定","reading":"あんのじょう","meaning":"सोचेजस्तै, अपेक्षा गरेअनुसार"},{"term":"場合","reading":"ばあい","meaning":"अवस्था, परिस्थिति"},{"term":"羽目","reading":"はめ","meaning":"अप्रिय अवस्था, परिस्थितिमा पर्नु"},{"term":"限り","reading":"かぎり","meaning":"सीमा, हद"},{"term":"可能性","reading":"かのうせい","meaning":"सम्भावना"},{"term":"極まる","reading":"きわまる","meaning":"अत्यन्त हुनु"},{"term":"極まりない","reading":"きわまりない","meaning":"अत्यन्त, अत्यधिक"},{"term":"極めて","reading":"きわめて","meaning":"धेरै, अत्यन्त"},{"term":"嫌い","reading":"きらい","meaning":"प्रवृत्ति, झुकाव"},{"term":"事","reading":"こと","meaning":"कुरा, विषय"},{"term":"事柄","reading":"ことがら","meaning":"विषयवस्तु"},{"term":"未だに","reading":"いまだに","meaning":"अहिलेसम्म, अझै पनि"},{"term":"予め","reading":"あらかじめ","meaning":"पहिले नै"},{"term":"如何なる","reading":"いかなる","meaning":"जुनसुकै, कुनै पनि"},{"term":"何しろ","reading":"なにしろ","meaning":"जे भए पनि, आखिर"},{"term":"何れにせよ","reading":"いずれにせよ","meaning":"जेसुकै भए पनि"},{"term":"言わせる","reading":"いわせる","meaning":"भन्न लगाउनु"},{"term":"掛かる","reading":"かかる","meaning":"निर्भर हुनु"},{"term":"堪える","reading":"たえる","meaning":"सहनु"},{"term":"値する","reading":"あたいする","meaning":"योग्य हुनु"},{"term":"足る","reading":"たる","meaning":"पर्याप्त हुनु"},{"term":"照らす","reading":"てらす","meaning":"तुलना गर्नु, आधार मान्नु"},{"term":"則る","reading":"のっとる","meaning":"अनुसार चल्नु"},{"term":"先駆ける","reading":"さきがける","meaning":"अग्रणी हुनु"},{"term":"即する","reading":"そくする","meaning":"अनुरूप हुनु"},{"term":"留まる","reading":"とどまる","meaning":"सीमित हुनु"},{"term":"依らず","reading":"よらず","meaning":"नभनी, सम्बन्ध नराखी"},{"term":"顧みる","reading":"かえりみる","meaning":"विचार गर्नु, ध्यान दिनु"},{"term":"兼ねる","reading":"かねる","meaning":"एकैसाथ गर्नु"},{"term":"皮切り","reading":"かわきり","meaning":"सुरुवात"},{"term":"機","reading":"き","meaning":"अवसर"},{"term":"余儀なくされる","reading":"よぎなくされる","meaning":"बाध्य हुनु"},{"term":"踏まえる","reading":"ふまえる","meaning":"आधार लिनु"},{"term":"経る","reading":"へる","meaning":"पार गर्नु, बित्न