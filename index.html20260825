ど","meaning":"परिपक्वताको स्तर"},{"term":"破損","reading":"はそん","meaning":"क्षति"},{"term":"欠品","reading":"けっぴん","meaning":"स्टक अभाव"},{"term":"コックレスキッチン","reading":"コックレスキッチン","meaning":"कुक-रहित भान्सा"},{"term":"セントラルキッチン","reading":"セントラルキッチン","meaning":"केन्द्रीय भान्सा (CK)"},{"term":"開発","reading":"かいはつ","meaning":"विकास"},{"term":"採用","reading":"さいよう","meaning":"अपनाउनु/ग्रहण गर्नु"},{"term":"方針","reading":"ほうしん","meaning":"नीति"},{"term":"在庫管理","reading":"ざいこかんり","meaning":"स्टक व्यवस्थापन"},{"term":"手持ち","reading":"てもち","meaning":"हातमा भएको"},{"term":"在庫額","reading":"ざいこがく","meaning":"स्टकको मूल्य"},{"term":"悪影響","reading":"あくえいきょう","meaning":"नराम्रो असर"},{"term":"先入れ先出し","reading":"さきいれさきだし","meaning":"पहिले आएको पहिले प्रयोग (FIFO)"}]},{"title":"पृष्ठ १८-१९ — किचन आधारभूत शब्दावली (参考) (भाग 4)","words":[{"term":"定位置管理","reading":"ていいちかんり","meaning":"निश्चित ठाउँमा राख्ने व्यवस्थापन"},{"term":"鮮度管理","reading":"せんどかんり","meaning":"ताजापन व्यवस्थापन"},{"term":"仕様書発注","reading":"しようしょはっちゅう","meaning":"विशेष विवरण अनुसार अर्डर"},{"term":"レシピ","reading":"レシピ","meaning":"रेसिपी"},{"term":"発注管理","reading":"はっちゅうかんり","meaning":"अर्डर व्यवस्थापन"},{"term":"保管管理","reading":"ほかんかんり","meaning":"भण्डारण व्यवस्थापन"},{"term":"厳守","reading":"げんしゅ","meaning":"कडाइका साथ पालना"},{"term":"均一化","reading":"きんいつか","meaning":"एकरूप बनाउने"},{"term":"コスト削減","reading":"コストさくげん","meaning":"लागत घटाउनु"},{"term":"単純化","reading":"たんじゅんか","meaning":"सरलीकरण"},{"term":"棚卸し","reading":"たなおろし","meaning":"स्टक जाँच (इन्भेन्टरी काउन्ट)"},{"term":"実地棚卸し","reading":"じっちたなおろし","meaning":"वास्तविक स्थलगत स्टक जाँच"},{"term":"原価管理","reading":"げんかかんり","meaning":"लागत व्यवस्थापन"},{"term":"バッシング","reading":"バッシング","meaning":"टेबल सफा गर्ने काम"},{"term":"残飯","reading":"ざんぱん","meaning":"बाँकी खाना"},{"term":"プレバッシング","reading":"プレバッシング","meaning":"अगावै टेबल सफा गर्ने काम"},{"term":"パントリー","reading":"パントリー","meaning":"भाँडाकुँडा राख्ने कोठा"}]},{"title":"पृष्ठ १८-१९ — किचन आधारभूत शब्दावली (参考) (भाग 5)","words":[{"term":"配膳室","reading":"はいぜんしつ","meaning":"खाना पस्किने कोठा"},{"term":"溜まり","reading":"たまり","meaning":"जम्मा हुने ठाउँ"},{"term":"苦情","reading":"くじょう","meaning":"गुनासो"},{"term":"プロダクションコントロール","reading":"プロダクションコントロール","meaning":"उत्पादन नियन्त्रण"},{"term":"入店状況","reading":"にゅうてんじょうきょう","meaning":"ग्राहक आगमन अवस्था"},{"term":"予測","reading":"よそく","meaning":"पूर्वानुमान"},{"term":"巧拙","reading":"こうせつ","meaning":"सीप वा असीप"},{"term":"ポーション","reading":"ポーション","meaning":"एक सर्भिङको मात्रा"},{"term":"メニュー基準表","reading":"メニューきじゅんひょう","meaning":"मेनु मापदण्ड तालिका"},{"term":"未然に防ぐ","reading":"みぜんにふせぐ","meaning":"हुनुअघि नै रोक्नु"},{"term":"オーバーポーション","reading":"オーバーポーション","meaning":"तोकिएभन्दा बढी मात्रा"},{"term":"アンダーポーション","reading":"アンダーポーション","meaning":"तोकिएभन्दा कम मात्रा"},{"term":"詳細","reading":"しょうさい","meaning":"विस्तृत विवरण"},{"term":"古典料理","reading":"こてんりょうり","meaning":"परम्परागत/शास्त्रीय खाना"},{"term":"アレンジされる","reading":"アレンジされる","meaning":"परिमार्जित हुनु"}]}];
const QA_PAGES_RAW = [{"title":"पृष्ठ 1 — परिचय र खाद्यसामग्री (肉類 - मासु) बारे","words":[{"question":"このテキストは何のために作られましたか。","answer":"特定技能２号で働くために必要な専門的な知識と技能を紹介するために作られました。"},{"question":"日本の食品の種類は何品くらいありますか。","answer":"「日本食品標準成分表２０２０年版（八訂）」によると、加工品を含め２，４７８品あります。"},{"question":"牛肉の部位の名称は何によって定められていますか。","answer":"社団法人日本食肉格付協会が定めた牛部分肉取引規格によって定められています。"},{"question":"豚肉と牛肉を比べたとき、豚肉の特徴は何ですか。","answer":"豚肉は出荷される月齢が牛肉より若く、脂肪分の多いばら肉を除き、肉質は比較的均一です。"},{"question":"鶏肉の部位の名称は何によって定められていますか。","answer":"農林水産省が定めた食鶏小売規格によって定められています。"}]},{"title":"पृष्ठ 2 — 肉の保存・調理の注意点 / 鮮度の見分け方","words":[{"question":"肉を加熱すると、なぜ肉が硬くなりますか。","answer":"肉の主成分であるタンパク質が熱によって変性し、縮んで肉汁が流れ出すため硬くなります。"},{"question":"肉が縮んで硬くなるのを防ぐ方法を挙げてください。","answer":"筋をあらかじめ切っておく、肉たたきでたたく、しょうが汁など肉を柔らかくする働きのあるものにつけておく方法があります。"},{"question":"すね肉のような筋の多い肉を柔らかくするにはどうすればよいですか。","answer":"長時間加熱すると、タンパク質の一種であるコラーゲンが分解されて柔らかくなります。"},{"question":"肉のうまみを逃さないための加熱方法は何ですか。","answer":"はじめに強火～中火で加熱して表面を凝固させ、その後、弱火で中まで火を通します。"},{"question":"結着肉（成形肉）を調理するときに注意することは何ですか。","answer":"細菌性食中毒を防止するために、肉の内部までしっかり火を通す必要があります。"},{"question":"新鮮な牛肉の見分け方は何ですか。","answer":"鮮やかな赤色で、赤身と脂身の境目がはっきりしているものが良いです。"},{"question":"冷凍した食肉を解凍するときの正しい方法は何ですか。","answer":"下処理用の容器に移し、食肉・魚介類などの保管区分の冷蔵庫内で緩慢解凍します。ドリップが他の食材や容器を汚染しないようトレイで受けるなどの工夫をします。"}]},{"title":"पृष्ठ 3 — 魚の保存・下ろし方 / 野菜・果実類","words":[{"question":"魚介類の中でもっとも早く傷むのは何ですか。","answer":"貝類がもっとも早く傷みます。"},{"question":"貝類や小魚を冷蔵庫に保存するときの注意点は何ですか。","answer":"温度変化の少ないところに保存します。"},{"question":"三枚おろしとはどのような下ろし方ですか。","answer":"頭を落とし、骨と身を左右に分けて３分割する下ろし方です。"},{"question":"フグを調理するときに注意することは何ですか。","answer":"フグは毒をもっているため、都道府県知事などが認めた専門のフグ処理者が処理する必要があります。"},{"question":"一尾魚を盛り付けるときのポイントは何ですか。","answer":"頭を左、腹を下に盛り付けます。付け合わせは、和食の場合は手前に置きます。"},{"question":"現在、日本の市場で流通する野菜の数はどのくらいですか。","answer":"１５０種類ほどと言われています。"},{"question":"野菜類に一般的に多く含まれる成分は何ですか。","answer":"水分が８０～９０％前後と多く、タンパク質、脂質、炭水化物は少ないです。重要な成分はカリウム、リン、カルシウム、鉄などの無機質、ビタミンＡ、ビタミンＣ、食物繊維です。"},{"question":"ほうれん草など青菜をゆでるときの注意点は何ですか。","answer":"緑色の色素（クロロフィル）が熱に弱いので、たっぷりのお湯で蓋をせずにさっとゆで、水にとって冷まします。"}]},{"title":"पृष्ठ 4 — 野菜の保存 / 国産食材（和牛・伝統野菜）","words":[{"question":"ごぼうやれんこんの切り口の褐変を防ぐにはどうすればよいですか。","answer":"切ったあと、すぐに水につけると切り口の褐変を防ぐことができます。"},{"question":"きゅうりやキャベツを塩でもむとどうなりますか。","answer":"浸透圧の作用で野菜から水分が出てしんなりします。"},{"question":"野菜を保存するときの基本的な方法は何ですか。","answer":"水分の蒸散を抑えるためラップなどに包み冷蔵庫で保存します。また、根や葉をつけておくと身の質が落ちるため、切り離して保存します。"},{"question":"和牛とは何品種を指しますか。","answer":"黒毛和種・褐毛和種・無角和種・日本短角種の４品種とそれらの交雑種のことを指します。"},{"question":"黒毛和牛の特徴は何ですか。","answer":"毛色は黒褐単色で、和牛全体の９５％以上を占め、肉質は特に脂肪交雑（さし）の面で優れています。"},{"question":"伝統野菜（在来野菜）とは何ですか。","answer":"昔から日本で作り続けられている、昔の姿や形のまま栽培が続けられている野菜のことです。地域の食文化に重要な役割を果たしています。"}]},{"title":"पृष्ठ 5 — 下処理の目的 / 野菜・肉の下処理","words":[{"question":"下処理の目的は何ですか。","answer":"調理の前に食材におこなう加工処理で、洗浄、あくをぬく、切れ目を入れる、乾物をもどすなどをおこない、味や食感をよくし、二次汚染を防ぐことが目的です。"},{"question":"調理前の食材に付着しているものは何ですか。","answer":"食中毒菌や腐敗にかかわる微生物が付着しています。"},{"question":"野菜を洗浄するときの基本的な方法は何ですか。","answer":"汚れの少ないものから１枚ずつ水につけて洗い、最後に流水で洗います。葉物は根元を広げるように丁寧に洗います。"},{"question":"じゃがいもやなすのあく抜きはどうしますか。","answer":"冷水につけてあく抜きをします。"},{"question":"れんこんやごぼうを白くするにはどうすればよいですか。","answer":"酢水に入れると白くなります。"},{"question":"肉の下処理で筋に切れ目を入れる理由は何ですか。","answer":"赤身と脂身の間にある筋は加熱により縮み、肉が反り返るので、それを防ぐために切れ目を入れます。"},{"question":"魚のうろこを落とすときの正しい方向は何ですか。","answer":"尾から頭の方向に向かってとります。"}]},{"title":"पृष्ठ 6 — 各調理方法（加熱調理・非加熱調理）","words":[{"question":"調理とは何ですか。","answer":"食材に手を加え、衛生的で安全なものにし、味や香り、口触りをよくして美味しいものにすることです。"},{"question":"「茹でる」とはどのような調理方法ですか。","answer":"多量の水又は熱湯の中で加熱する調理方法です。"},{"question":"「炒める」調理で複数の食材を入れるときの注意点は何ですか。","answer":"熱の通りが遅い具材から先に入れて、熱の入り具合を均等にします。"},{"question":"油の劣化を防ぐための注意点を挙げてください。","answer":"空気になるべくさらさない、長時間の加熱を避ける、直射日光に当てない、不純物を混ぜないことに注意します。"},{"question":"非加熱調理とは何ですか。","answer":"熱を加えずにおこなう調理方法で、混合や撹拌、冷却などがあります。"}]},{"title":"पृष्ठ 7 — 非加熱調理の注意事項 / 調理計画 / 調理機器","words":[{"question":"手で和えるときの正しい衛生対応は何ですか。","answer":"手をよく洗った後に使い捨て手袋を着用します。"},{"question":"生食用冷凍魚介類（刺身用）を解凍するときの注意点は何ですか。","answer":"組織の破壊や汁の流出が起きないよう、なるべく低温で時間をかけて解凍します。"},{"question":"青菜類に生食用の冷凍品がない理由は何ですか。","answer":"色を保持するためブランチング（短時間に６０℃以上の熱を加え酵素を失活させる処理）が必要なため、生食用冷凍品はありません。"},{"question":"調理計画を作成する目的は何ですか。","answer":"次に何をしなければならないかを明確化し、作業の効率化及び料理の品質を維持するためです。"},{"question":"ガスレンジを使うときに必ずしなければならないことは何ですか。","answer":"必ず換気（換気扇・窓）をおこなう必要があります。換気が不十分だと一酸化炭素中毒を起こす恐れがあります。"}]},{"title":"पृष्ठ 8 — 熱機器（スチームコンベクションオーブン・フライヤー等）","words":[{"question":"自動温度調節機能がついている調理機器を確認する方法は何ですか。","answer":"設定温度と実際の温度が一致しているか、非接触温度計で確認します。"},{"question":"スチームコンベクションオーブンの扉を開けるときの注意点は何ですか。","answer":"加熱調理直後の庫内には高温の水蒸気が充満しているため、急にとびらを開けると手や顔にやけどをする恐れがあるので注意が必要です。"},{"question":"フライヤーの油はAV値がいくつ以上のときに交換しますか。","answer":"AV値３．０以上であれば、その日の営業終了時に油を交換します。"},{"question":"立体式炊飯器や卓上炊飯器で炊きあがったライスについて必ずすべきことは何ですか。","answer":"必ず試食し、異常がある場合は提供せずオーダーストップするなどの対応を取ります。"}]},{"title":"पृष्ठ 9 — 冷機器 / 洗浄消毒機器 / 包丁とまな板","words":[{"question":"冷蔵庫・冷凍庫で雑菌が付きやすい場所はどこですか。","answer":"扉、取っ手、扉パッキン、扉下部です。"},{"question":"氷用スコップに菌の付着が多い理由は何ですか。","answer":"不特定多数の人が触れるものだからです。"},{"question":"食器の洗浄機の基本的な洗浄温度とすすぎ温度は何度ですか。","answer":"洗浄温度は６０～７０℃、すすぎ温度は８０～９０℃（リンス剤添加）が基本です。"},{"question":"包丁及びまな板はどのように分類して使い分けますか。","answer":"肉用、野菜用、下処理用などに分類して使い分けます。"},{"question":"柳刃包丁（刺身包丁）は主に何を切るときに使いますか。","answer":"主に刺身を切るときに使用します。"},{"question":"出刃包丁の特徴は何ですか。","answer":"魚をさばくときに使用する包丁で、重みがあり刃に厚みもあるため骨を切ることもできます。"}]},{"title":"पृष्ठ 10 — 容器 / フライパン・鍋 / 計測機器類","words":[{"question":"キッチンポットやボールを洗浄するときに使ってはいけないものは何ですか。","answer":"スチールたわしは絶対に使用してはいけません。"},{"question":"フッ素加工のフライパンを洗うときの注意点は何ですか。","answer":"表面の加工を傷めないよう柔らかいスポンジと中性洗剤で洗い、使用直後の熱いうちに水をかけて急に冷やさないようにします。"},{"question":"鉄フライパンを使用後にする手入れの手順は何ですか。","answer":"たわしなどで洗い、水気をふき取り、中火で加熱して完全に水気をとばし、内側に油をすり込むように塗ります。"},{"question":"計測機器類を定期的に確認する必要がある理由は何ですか。","answer":"精密機械なので汚れや振動が計測の精度に影響を及ぼすことがあるため、正しく計測できているか定期的に確認する必要があります。"}]},{"title":"पृष्ठ 11 — 飲食店の労働災害の発生状況","words":[{"question":"飲食店での労働災害で最も多い事故は何ですか。","answer":"「転倒」で、全体の約３割を占めています。"},{"question":"全産業と比較して飲食店で高い事故の類別は何ですか。","answer":"「切れ・こすれ」、「高温・低温物との接触」が全産業と比較して高く、過去５年間減少していません。"},{"question":"飲食店に特徴的な労働災害の状況は何ですか。","answer":"若年層の労働者が多く、その被災が目立っています。"},{"question":"飲食店における労働安全管理が十分におこなわれていない理由は何ですか。","answer":"「転倒」「切れ・こすれ」が多くを占めているが、法令上の義務付けがないため、安全面からの取組が十分におこなわれていない現状があります。"}]},{"title":"पृष्ठ 12 — 危険の見える化（転倒・切傷の例）","words":[{"question":"「見える化」とは何のためにおこないますか。","answer":"危険認識や作業場の注意喚起を分かりやすく知らせ、より効果的な安全活動をおこなうためです。"},{"question":"転倒の危険を防ぐための基本的な対応は何ですか。","answer":"床を濡れたままにせず、濡れた床をすぐにふき取ります。"},{"question":"切傷の危険がある場所の例を挙げてください。","answer":"包丁、シンク、食用缶、食器などが切傷の危険がある場所の例です。"}]},{"title":"पृष्ठ 13 — 危険の見える化（火傷・腰痛の例）と作業マニュアル","words":[{"question":"厨房で火傷の危険がある場面の例を挙げてください。","answer":"熱い鍋を扱うとき、揚げ物の油を扱うとき、同僚とぶつかったとき、濡れた床でバランスを崩したときなどです。"},{"question":"腰痛を防ぐための荷物の持ち方は何ですか。","answer":"荷物をできるだけ体に近づけて持ちます。体から離して持つと腰痛の危険が高まります。"},{"question":"危険の見える化を職場で実践するための具体的な取り組みを挙げてください。","answer":"作業手順に危険個所を見える化した作業マニュアルを作成する、職場の危険を見える化したハザードマップを作成・掲示・周知する、定期的に従業員へ指導することです。"}]},{"title":"पृष्ठ 14 — 具体的な労働災害防止策 / 食品加工機械の法規制","words":[{"question":"５Ｓ活動とは何ですか。","answer":"整理、整頓、清掃、清潔、習慣の５つのことで、これを徹底することで労働災害防止と作業の効率化が期待できます。"},{"question":"重い荷物を運ぶときの転倒リスク低減の方法は何ですか。","answer":"台車を使う、ひとりでは持たない、何回かに分けて運ぶなどの措置をとります。"},{"question":"刃物を使用するときの注意点は何ですか。","answer":"目線を外さないようにし、使い終わった刃物は指定された場所に片づけます。"},{"question":"フライヤーを使う際に着用すべきものは何ですか。","answer":"長靴、長エプロン、耐熱手袋を着用します。"},{"question":"食品加工用切断機・切削機による危険を防止するための措置は何ですか。","answer":"切断に必要な部分以外の危険な部分に覆いなどを設置し、原材料の送給や取りだし時には機械の運転を停止するか用具などを使用します。"},{"question":"機械の目詰まりの調整時にとるべき原則的な措置は何ですか。","answer":"原則として、機械の運転を停止するなどの措置が義務付けられています。"}]},{"title":"पृष्ठ 15 — 食品の流通","words":[{"question":"食品の流通経路とはどのようなものですか。","answer":"食品が生産者から消費者に届くまでの経路で、生産者から農協などの出荷事業者、卸売市場や食品製造業、食品小売業などを経由して消費者に届きます。"},{"question":"卸売市場が持つ６つの機能は何ですか。","answer":"①集荷、②価格形成、③決済、④情報受発信、⑤災害時対応、⑥衛生の保持です。"},{"question":"飲食店が食材を仕入れる際の仕入先にはどのようなものがありますか。","answer":"①小売店（近隣商店・スーパー）、②業務用専門スーパー、③卸売市場、④卸売業者（通信販売も含む）などがあります。"}]},{"title":"पृष्ठ 16 — 食品添加物とは","words":[{"question":"食品添加物とは何ですか。","answer":"食品の製造過程において、加工や保存の目的で食品に添加されるもののことです。"},{"question":"食品添加物の安全性は誰が確認していますか。","answer":"食品安全基本法に基づき設置された食品安全委員会が動物試験などの結果をもとに評価し、安全性を確認します。"},{"question":"食品添加物には主に何種類ありますか。","answer":"指定添加物、既存添加物、一般飲食物添加物、天然香料の４つの種類があります。"}]},{"title":"पृष्ठ 17 — 添加物の種類と用途","words":[{"question":"甘味料の目的と代表的な品名は何ですか。","answer":"食品に甘味を与えることが目的で、キシリトールやアスパルテームなどがあります。"},{"question":"保存料の目的は何ですか。","answer":"かびや細菌などの発育を抑制し、食品の保存性を向上させることが目的です。"},{"question":"発色剤の目的は何ですか。","answer":"肉類の色調・風味を改善することが目的です。"},{"question":"調味料の目的と代表的な品名は何ですか。","answer":"食品にうまみを与えることが目的で、L-グルタミン酸ナトリウムなどがあります。"}]},{"title":"पृष्ठ 18 — キッチン基本用語（ア～ハ行）","words":[{"question":"「洗い場」とはどのような場所ですか。","answer":"調理場とホールとの接点にあり、主にホールより下がって来た食器の洗浄作業をおこなう場所です。"},{"question":"「キッチンヘルパー」とは何ですか。","answer":"調理場のコックの補佐をする調理補助のことで、ピーク前に各種食材を準備したり、簡単な仕込み作業をおこないます。"},{"question":"「先入れ先出し」とは何ですか。","answer":"検品後に箱に日付を記入したり日付のタグを付けて定位置管理をおこない、古い順に食材を使用するようにローテーションをおこなうことで、鮮度管理の基本となる手法です。"},{"question":"「在庫管理」の重要性は何ですか。","answer":"食材や備品、消耗品の在庫は物に変わっているだけでお金を寝かせていることと同じであり、在庫期間が長いと劣化し品質にも悪影響を与えるため重要です。"}]},{"title":"पृष्ठ 19 — キッチン基本用語（サ～ラ行）","words":[{"question":"「セントラルキッチン（CK）」とは何ですか。","answer":"食材の第一次加工をおこなう集中調理工場のことで、チェーン展開する外食企業が自店の味の均一化とコスト削減を目的として建設します。"},{"question":"「棚卸し」とは何ですか。","answer":"食材や備品、消耗品などの手持ちの数量を各品目ごとに実際に調べ、在庫量と在庫額を把握する作業のことです。"},{"question":"「ポーション」とは何ですか。","answer":"分量のことで、各メニューはメニュー基準表により各食材の分量が決められています。決まった分量より多く付けることをオーバーポーション、逆をアンダーポーションといいます。"},{"question":"「プレバッシング」とは何ですか。","answer":"お客様の食事中に不要となった食器を下げる作業のことで、重要な基本作業の一つです。"}]}];

/* ---------- course registry (ported from the React Native app) ---------- */
function normalizeVocab(raw){
  return raw.map(item => ({
    term: item.term || item.kanji || '',
    reading: item.reading || item.hiragana || '',
    meaning: item.meaning || item.nepali || '',
  }));
}
function normalizeVocabPages(rawPages){
  return rawPages.map(p => ({ title: p.title, words: normalizeVocab(p.words) }));
}
function normalizeQAPages(rawPages){
  return rawPages.map(p => ({ title: p.title, words: p.words.map(w => ({ question: w.question, answer: w.answer })) }));
}

const COURSES = [
  { id:'n1-kanji', title:'N1 漢字帳', subtitle:'JLPT N1 · Kanji', icon:'語', levelSize:15, words: normalizeVocab(N1_KANJI_RAW) },
  { id:'ssw2-food-service', title:'SSW2 Food Service', subtitle:'外食業特定技能２号 · 飲食物調理', icon:'🍳', pages: normalizeVocabPages(SSW2_PAGES_RAW) },
  { id:'qa-food', title:'Q&A Food', subtitle:'外食業特定技能２号 · प्रश्न-उत्तर अभ्यास', type:'qa', icon:'❓', pages: normalizeQAPages(QA_PAGES_RAW) },
];

function chunk(arr, size){ const out=[]; for(let i=0;i<arr.length;i+=size) out.push(arr.slice(i,i+size)); return out; }
function getCourseLevels(course){ return course.pages ? course.pages.map(p=>p.words) : chunk(course.words, course.levelSize||15); }
function getLevelTitle(course, i){ return (course.pages && course.pages[i]) ? course.pages[i].title : null; }
function getAllWords(course){ return course.pages ? course.pages.flatMap(p=>p.words) : course.words; }
function isQACourse(course){ return course.type === 'qa'; }
function getCourseById(id){ return COURSES.find(c=>c.id===id) || COURSES[0]; }

/* ---------- progress persistence ---------- */
const STORAGE_KEY = 'n1kanji-notebook-progress';
let PROGRESS = { courses: {} };

function courseState(courseId){
  if(!PROGRESS.courses[courseId]) PROGRESS.courses[courseId] = { unlockedLevels:1, clearedLevels:{}, wordStats:{} };
  return PROGRESS.courses[courseId];
}
async function loadProgress(){
  try{
    if(window.storage){
      const res = await window.storage.get(STORAGE_KEY, false);
      if(res && res.value) PROGRESS = JSON.parse(res.value);
    } else {
      const raw = localStorage.getItem(STORAGE_KEY);
      if(raw) PROGRESS = JSON.parse(raw);
    }
  }catch(e){ /* start fresh */ }
}
async function saveProgress(){
  try{
    if(window.storage){ await window.storage.set(STORAGE_KEY, JSON.stringify(PROGRESS), false); }
    else { localStorage.setItem(STORAGE_KEY, JSON.stringify(PROGRESS)); }
  }catch(e){ /* best effort */ }
}
function recordAnswer(courseId, key, correct){
  const s = courseState(courseId);
  const cur = s.wordStats[key] || { correct:0, wrong:0 };
  s.wordStats[key] = correct ? {...cur, correct: cur.correct+1} : {...cur, wrong: cur.wrong+1};
  saveProgress();
}
function markLevelCleared(courseId, levelIndex){
  const s = courseState(courseId);
  if(!s.clearedLevels[levelIndex]){ s.clearedLevels[levelIndex] = true; saveProgress(); }
}
function unlockNextLevel(courseId, maxLevels){
  const s = courseState(courseId);
  if(s.unlockedLevels < maxLevels){ s.unlockedLevels++; saveProgress(); }
}
function getCourseStats(courseId, words){
  const s = courseState(courseId);
  let mastered=0, learning=0;
  words.forEach(w=>{
    const key = w.term || w.question;
    const st = s.wordStats[key];
    if(!st) return;
    if(st.correct>=2 && st.correct>st.wrong) mastered++;
    else if(st.correct>0 || st.wrong>0) learning++;
  });
  return { mastered, learning, total: words.length, untouched: words.length - mastered - learning };
}

/* ---------- shuffle ---------- */
function shuffle(arr){
  const a = arr.slice();
  for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; }
  return a;
}

/* ---------- app state ---------- */
let state = {
  screen: 'courseSelect',
  course: null,
  mode: 'reading',
  levelIndex: 0,
  quiz: null, // { words, idx, correctCount, streak, missed, answered, selected, qMode, options, isQA }
  resultData: null,
};

function showScreen(name){
  document.querySelectorAll('.screen').forEach(el=>el.classList.remove('active'));
  document.getElementById('screen-'+name).classList.add('active');
  state.screen = name;
}

/* ---------- course select ---------- */
function renderCourseSelect(){
  const wrap = document.getElementById('courseList');
  wrap.innerHTML = '';
  COURSES.forEach(course=>{
    const levels = getCourseLevels(course);
    const el = document.createElement('button');
    el.className = 'course-card';
    el.style.width = '100%';
    el.style.border = '1px solid var(--line)';
    el.style.background = 'var(--card)';
    el.innerHTML = `
      <div class="course-icon">${course.icon||'学'}</div>
      <div style="flex:1; text-align:left;">
        <div class="course-title">${course.title}</div>
        <div class="course-sub">${course.subtitle}</div>
        <div class="course-meta">${getAllWords(course).length} शब्द · ${levels.length} तह</div>
      </div>
      <div class="chevron">›</div>
    `;
    el.addEventListener('click', ()=>{
      state.course = course;
      state.mode = isQACourse(course) ? 'qa' : 'reading';
      renderHome();
      showScreen('home');
    });
    wrap.appendChild(el);
  });
}

/* ---------- home ---------- */
const MODES = [
  { key:'reading', label:'漢字 → ひらがな (उच्चारण)' },
  { key:'meaning', label:'漢字 → अर्थ (नेपाली)' },
  { key:'mixed', label:'मिसाएर (Mixed)' },
];

function renderHome(){
  const course = state.course;
  const isQA = isQACourse(course);
  const levels = getCourseLevels(course);
  const allWords = getAllWords(course);
  const cs = courseState(course.id);
  const stats = getCourseStats(course.id, allWords);
  const unit = isQA ? 'प्रश्न' : 'वाक्यांश';

  document.getElementById('homeBrandMark').textContent = course.icon || '語';
  document.getElementById('homeTitle').textContent = course.title;
  document.getElementById('homeSub').textContent = `${course.subtitle} · ${stats.total} ${unit}`;
  document.getElementById('statMastered').textContent = stats.mastered;
  document.getElementById('statLearning').textContent = stats.learning;
  document.getElementById('statNew').textContent = stats.untouched;

  const modeSection = document.getElementById('modeSection');
  if(isQA){
    modeSection.style.display = 'none';
  } else {
    modeSection.style.display = 'block';
    const modeList = document.getElementById('modeList');
    modeList.innerHTML = '';
    MODES.forEach(m=>{
      const el = document.createElement('button');
      el.className = 'mode-opt' + (state.mode===m.key ? ' active' : '');
      el.style.width = '100%';
      el.style.textAlign = 'left';
      el.innerHTML = `<div class="radio"></div><div class="mode-opt-text">${m.label}</div>`;
      el.addEventListener('click', ()=>{ state.mode = m.key; renderHome(); });
      modeList.appendChild(el);
    });
  }

  const levelList = document.getElementById('levelList');
  levelList.innerHTML = '';
  levels.forEach((words, index)=>{
    const unlocked = index < cs.unlockedLevels;
    const cleared = !!cs.clearedLevels[index];
    const pageTitle = getLevelTitle(course, index);
    const start = index*(course.levelSize||15)+1;
    const end = start + words.length - 1;
    const btn = document.createElement('button');
    btn.className = 'level-card';
    btn.disabled = !unlocked;
    btn.innerHTML = `
      <div class="level-badge${cleared?' cleared':''}">${cleared?'✓':(index+1)}</div>
      <div class="level-info">
        <div class="level-title">${pageTitle ? pageTitle : 'तह '+(index+1)}</div>
        <div class="level-sub">${pageTitle ? words.length+' '+(isQA?'प्रश्न':'शब्द') : 'शब्द '+start+'–'+end}</div>
      </div>
      ${unlocked ? '' : '<div class="lock-icon">🔒</div>'}
    `;
    if(unlocked){
      btn.addEventListener('click', ()=> startLevel(index));
    }
    levelList.appendChild(btn);
  });
}

document.getElementById('btnChangeCourse').addEventListener('click', ()=>{
  renderCourseSelect();
  showScreen('courseSelect');
});

/* ---------- quiz ---------- */
function buildOptionsByField(correctVal, field, pool){
  const shuffled = shuffle(pool.filter(w => w[field] && w[field] !== correctVal));
  const seen = new Set();
  const distractors = [];
  for(const w of shuffled){
    if(distractors.length>=3) break;
    if(seen.has(w[field])) continue;
    seen.add(w[field]);
    distractors.push(w[field]);
  }
  return shuffle([correctVal, ...distractors]);
}

function startLevel(levelIndex){
  const course = state.course;
  const isQA = isQACourse(course);
  const levels = getCourseLevels(course);
  const words = shuffle(levels[levelIndex]);
  const allWords = getAllWords(course);

  state.levelIndex = levelIndex;
  state.quiz = {
    words, allWords, isQA,
    idx: 0, correctCount: 0, streak: 0, missed: [],
    answered: false, selected: null, qMode: null, options: [],
  };
  showScreen('quiz');
  showQuestion();
}

function currentQMode(){
  const q = state.quiz;
  if(q.isQA) return 'qa';
  if(state.mode==='mixed') return Math.random()<0.5 ? 'reading':'meaning';
  return state.mode;
}

function showQuestion(){
  const q = state.quiz;
  const course = state.course;
  q.answered = false; q.selected = null;

  document.getElementById('stamp1').classList.remove('show','wrong');
  document.getElementById('stamp2').classList.remove('show','wrong');
  document.getElementById('feedback').classList.remove('show');

  const pct = (q.idx / q.words.length) * 100;
  document.getElementById('progressFill').style.width = pct+'%';
  document.getElementById('countPill').textContent = (q.idx+1)+'/'+q.words.length;
  document.getElementById('streakNum').textContent = q.streak;

  const item = q.words[q.idx];
  q.qMode = currentQMode();
  const field = q.isQA ? 'answer' : (q.qMode==='meaning' ? 'meaning' : 'reading');
  const correctVal = item[field];
  q.options = buildOptionsByField(correctVal, field, q.allWords);

  const vocabStage = document.getElementById('vocabStage');
  const qaStage = document.getElementById('qaStage');
  if(q.isQA){
    vocabStage.style.display='none'; qaStage.style.display='flex';
    document.getElementById('qaQuestion').textContent = item.question;
  } else {
    qaStage.style.display='none'; vocabStage.style.display='flex';
    document.getElementById('kanjiTag').textContent = q.qMode==='reading' ? 'यसको उच्चारण छान्नुहोस्' : 'यसको अर्थ छान्नुहोस्';
    document.getElementById('kanjiBig').textContent = item.term;
  }

  const wrap = document.getElementById('optionsWrap');
  wrap.innerHTML = '';
  q.options.forEach(val=>{
    const btn = document.createElement('button');
    btn.className = 'opt-btn' + (q.isQA ? ' qa' : (q.qMode==='meaning' ? ' small nepali' : ''));
    btn.textContent = val;
    btn.addEventListener('click', ()=> commitAnswer(val));
    wrap.appendChild(btn);
  });
}

function commitAnswer(pickedVal){
  const q = state.quiz;
  const course = state.course;
  if(q.answered) return;
  q.answered = true; q.selected = pickedVal;

  const item = q.words[q.idx];
  const field = q.isQA ? 'answer' : (q.qMode==='meaning' ? 'meaning' : 'reading');
  const correctVal = item[field];
  const correct = pickedVal === correctVal;

  document.querySelectorAll('#optionsWrap .opt-btn').forEach(b=>{
    b.setAttribute('disabled','true');
    if(b.textContent === correctVal) b.classList.add('correct');
    else if(b.textContent === pickedVal) b.classList.add('wrong');
    else b.classList.add('dim');
  });

  recordAnswer(course.id, item.term || item.question, correct);
  if(correct){ q.correctCount++; q.streak++; } else { q.streak=0; q.missed.push(item); }
  document.getElementById('streakNum').textContent = q.streak;

  const stampEl = q.isQA ? document.getElementById('stamp2') : document.getElementById('stamp1');
  stampEl.textContent = correct ? '合' : '否';
  stampEl.classList.toggle('wrong', !correct);
  stampEl.classList.add('show');

  const fbIcon = document.getElementById('fbIcon');
  const fbTitle = document.getElementById('fbTitle');
  fbIcon.className = 'fb-icon ' + (correct?'ok':'no');
  fbIcon.textContent = correct ? '✓' : '✕';
  fbTitle.className = 'fb-title ' + (correct?'ok':'no');
  fbTitle.textContent = correct ? 'ठीक छ! सही जवाफ।' : 'अफसोस, सही जवाफ हेर्नुहोस्।';
  document.getElementById('fbReading').style.display = q.isQA ? 'none' : 'block';
  document.getElementById('fbReading').textContent = q.isQA ? '' : item.reading;
  document.getElementById('fbMeaning').textContent = q.isQA ? item.answer : item.meaning;
  document.getElementById('feedback').classList.add('show');
}

document.getElementById('btnIdk').addEventListener('click', ()=>{
  const q = state.quiz;
  if(q.answered) return;
  commitAnswer(null);
});

document.getElementById('btnQuitQuiz').addEventListener('click', ()=>{
  renderHome();
  showScreen('home');
});

document.getElementById('btnNext').addEventListener('click', ()=>{
  document.getElementById('feedback').classList.remove('show');
  const q = state.quiz;
  setTimeout(()=>{
    q.idx++;
    if(q.idx >= q.words.length){ finishQuiz(); }
    else { showQuestion(); }
  }, 180);
});

/* ---------- result ---------- */
function finishQuiz(){
  const q = state.quiz;
  const course = state.course;
  const isQA = q.isQA;
  const levels = getCourseLevels(course);
  const levelIndex = state.levelIndex;
  const total = q.words.length;
  const pct = Math.round((q.correctCount/total)*100);
  const perfect = pct === 100;
  const unit = isQA ? 'प्रश्न' : 'शब्द';

  if(perfect) markLevelCleared(course.id, levelIndex);

  const cs = courseState(course.id);
  const isFrontier = levelIndex === cs.unlockedLevels - 1;
  const isLastLevel = levelIndex === levels.length - 1;
  const eligible = perfect && isFrontier && !isLastLevel;

  document.getElementById('resultPct').textContent = pct+'%';
  document.getElementById('resultFrac').textContent = q.correctCount+'/'+total;
  const ring = document.getElementById('resultRing');
  ring.style.borderColor = pct===100 ? 'var(--moss)' : (pct>=50 ? 'var(--gold)' : 'var(--seal)');

  let title = 'राम्रो प्रयास!';
  if(pct===100) title='उत्कृष्ट! सबै सही!';
  else if(pct>=70) title='राम्रो गर्नुभयो!';
  else if(pct<40) title='फेरि अभ्यास गरौं';
  document.getElementById('resultTitle').textContent = title;
  document.getElementById('resultSub').textContent = q.missed.length
    ? q.missed.length+' वटा '+unit+'मा फेरि अभ्यास गर्नुहोस्।'
    : 'सबै '+unit+' सही भयो, बधाई छ!';

  const unlockWrap = document.getElementById('unlockWrap');
  unlockWrap.innerHTML = '';
  if(eligible){
    const nextTitle = getLevelTitle(course, levelIndex+1);
    const nextCount = levels[levelIndex+1] ? levels[levelIndex+1].length : 0;
    const div = document.createElement('div');
    div.className = 'unlock-card';
    div.innerHTML = `
      <div class="unlock-title">तह ${levelIndex+1} पूरा भयो 🎉</div>
      <div class="unlock-sub">${nextTitle ? `अर्को खण्ड "${nextTitle}" (${nextCount} ${unit}) unlock भयो।` : `अर्को तह (तह ${levelIndex+2}) unlock भयो।`}</div>
    `;
    unlockWrap.appendChild(div);
    unlockNextLevel(course.id, levels.length);
  }

  const missWrap = document.getElementById('missWrap');
  missWrap.innerHTML = '';
  if(q.missed.length){
    const label = document.createElement('div');
    label.className = 'miss-label';
    label.textContent = 'फेरि हेर्नुपर्ने '+unit+'हरू';
    missWrap.appendChild(label);
    q.missed.forEach(item=>{
      const row = document.createElement('div');
      if(isQA){
        row.className = 'miss-qa';
        row.innerHTML = `<div class="miss-qa-q">${item.question}</div><div class="miss-qa-a">${item.answer}</div>`;
      } else {
        row.className = 'miss-item';
        row.innerHTML = `<div class="miss-kanji">${item.term}</div><div class="miss-reading">${item.reading}</div><div class="miss-meaning nepali">${item.meaning}</div>`;
      }
      missWrap.appendChild(row);
    });
  }

  showScreen('result');
}

document.getElementById('btnRetry').addEventListener('click', ()=> startLevel(state.levelIndex));
document.getElementById('btnResultHome').addEventListener('click', ()=>{ renderHome(); showScreen('home'); });

/* ---------- boot ---------- */
(async function boot(){
  await loadProgress();
  renderCourseSelect();
  showScreen('courseSelect');
})();
</script>
</body>
</html>
